{
  "openapi": "3.0.0",
  "info": {
    "title": "Коран Онлайн API",
    "description": "API для сервиса онлайн-обучения чтению Корана",
    "version": "1.0.0",
    "contact": {
      "name": "API Support"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local server"
    }
  ],
  "paths": {
    "/api/lessons": {
      "get": {
        "summary": "Получить список уроков",
        "operationId": "getLessons",
        "tags": ["Lessons"],
        "responses": {
          "200": {
            "description": "Успешно получен список уроков",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Lesson"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/lessons/{id}": {
      "get": {
        "summary": "Получить урок по ID",
        "operationId": "getLessonById",
        "tags": ["Lessons"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Урок найден",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Lesson"
                }
              }
            }
          },
          "404": {
            "description": "Урок не найден"
          }
        }
      }
    },
    "/api/schedule": {
      "get": {
        "summary": "Получить расписание занятий",
        "operationId": "getSchedule",
        "tags": ["Schedule"],
        "responses": {
          "200": {
            "description": "Расписание получено",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Session"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Lesson": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "level": {
            "type": "string",
            "enum": ["beginner", "intermediate", "advanced"]
          },
          "duration": {
            "type": "integer"
          }
        }
      },
      "Session": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "teacher": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date-time"
          },
          "duration": {
            "type": "integer"
          },
          "available": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
