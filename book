        image: "https://images.unsplash.com/photo-1512820790803-83ca734da794?auto=format&fit=crop&w=600&q=80"
    }

];


let cart = [];

let currentCategory = "Все";

let searchQuery = "";


const productsContainer =
    document.getElementById("products");

const searchInput =
    document.getElementById("searchInput");

const sortSelect =
    document.getElementById("sortSelect");

const cartOverlay =
    document.getElementById("cartOverlay");

const cartItems =
    document.getElementById("cartItems");

const cartCount =
    document.getElementById("cartCount");

const cartTotal =
    document.getElementById("cartTotal");

const toast =
    document.getElementById("toast");


function formatPrice(price) {

    return price.toLocaleString("ru-RU") + " ₽";

}


function renderBooks() {

    let filtered = books.filter(book => {

        const categoryMatch =
            currentCategory === "Все" ||
            book.category === currentCategory;

        const searchMatch =
            book.title.toLowerCase().includes(searchQuery) ||
            book.author.toLowerCase().includes(searchQuery) ||
            book.category.toLowerCase().includes(searchQuery);

        return categoryMatch && searchMatch;

    });


    if (sortSelect.value === "cheap") {

        filtered.sort((a, b) => a.price - b.price);

    }

    if (sortSelect.value === "expensive") {

        filtered.sort((a, b) => b.price - a.price);

    }


    document.getElementById("resultText").textContent =
        filtered.length + " книг";


    productsContainer.innerHTML = "";


    if (filtered.length === 0) {

        productsContainer.innerHTML = `
            <div style="
                grid-column:1/-1;
                text-align:center;
                padding:60px;
                color:#777;
            ">
                <h3>Книги не найдены</h3>
                <p>Попробуйте изменить запрос.</p>
            </div>
        `;

        return;

    }


    filtered.forEach(book => {

        const card = document.createElement("article");

        card.className = "book-card";


        card.innerHTML = `

            <button
                class="favorite"
                onclick="toggleFavorite(this)"
            >
                ♡
            </button>

            <div class="book-cover">

                <img
                    src="${book.image}"
                    alt="${book.title}"
                >

            </div>

            <div class="book-info">

                <div class="book-category">
                    ${book.category}
                </div>

                <h3 class="book-title">
                    ${book.title}
                </h3>

                <p class="book-author">
                    ${book.author}
                </p>

                <div class="rating">
                    ${book.rating}
                </div>

                <div class="book-bottom">

                    <div class="price">
                        ${formatPrice(book.price)}
                    </div>

                    <button
                        class="add-btn"
                        onclick="addToCart(${book.id})"
                    >
                        В корзину
                    </button>

                </div>

            </div>
        `;


        productsContainer.appendChild(card);

    });

}


function addToCart(id) {

    const book =
        books.find(book => book.id === id);

    cart.push(book);

    updateCart();

    showToast("Книга добавлена в корзину");

}


function removeFromCart(index) {

    cart.splice(index, 1);

    updateCart();

}


function updateCart() {

    cartCount.textContent = cart.length;


    cartItems.innerHTML = "";


    if (cart.length === 0) {

        cartItems.innerHTML = `
            <div class="empty-cart">
                🛒
                <br><br>
                Ваша корзина пуста
            </div>
        `;

        cartTotal.textContent = "0 ₽";

        return;

    }


    let total = 0;


    cart.forEach((book, index) => {

        total += book.price;


        const item =
            document.createElement("div");

        item.className = "cart-item";


        item.innerHTML = `

            <img
                src="${book.image}"
                alt="${book.title}"
            >

            <div class="cart-item-info">

                <h4>
                    ${book.title}
                </h4>

                <p>
                    ${formatPrice(book.price)}
                </p>

                <button
                    class="remove-item"
                    onclick="removeFromCart(${index})"
                >
                    Удалить
                </button>

            </div>
        `;


        cartItems.appendChild(item);

    });


    cartTotal.textContent =
        formatPrice(total);

}


function filterCategory(category) {

    currentCategory = category;

    document.getElementById("catalog")
        .scrollIntoView({
            behavior: "smooth"
        });

    renderBooks();

}


function toggleFavorite(button) {

    button.classList.toggle("active");

    button.textContent =
        button.classList.contains("active")
        ? "♥"
        : "♡";

}


function showToast(message) {

    toast.textContent = message;

    toast.classList.add("show");


    setTimeout(() => {

        toast.classList.remove("show");

    }, 2500);

}


searchInput.addEventListener(
    "input",
    function() {

        searchQuery =
            this.value.toLowerCase().trim();

        renderBooks();

    }
);


sortSelect.addEventListener(
    "change",
    renderBooks
);


document.getElementById("cartButton")
    .addEventListener("click", () => {

        cartOverlay.classList.add("open");

    });


document.getElementById("closeCart")
    .addEventListener("click", () => {

        cartOverlay.classList.remove("open");

    });


cartOverlay.addEventListener("click", event => {

    if (event.target === cartOverlay) {

        cartOverlay.classList.remove("open");

    }

});


document.getElementById("checkoutButton")
    .addEventListener("click", () => {

        if (cart.length === 0) {

            showToast("Сначала добавьте книгу в корзину");

            return;

        }

        showToast(
            "Заказ готов к оформлению!"
        );

    });


document.getElementById("newsletterForm")
    .addEventListener("submit", event => {

        event.preventDefault();

        event.target.reset();

        showToast(
            "Вы успешно подписались на новости!"
        );

    });


renderBooks();

updateCart();

</script>

