<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>BookHouse — Интернет-магазин книг</title>

<style>
    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    :root {
        --dark: #171717;
        --green: #315c45;
        --green-dark: #234534;
        --cream: #f7f3eb;
        --white: #ffffff;
        --gray: #777;
        --border: #e8e4dc;
        --gold: #c49345;
    }

    html {
        scroll-behavior: smooth;
    }

    body {
        font-family: Arial, sans-serif;
        background: #fff;
        color: var(--dark);
    }

    button,
    input,
    select {
        font: inherit;
    }

    button {
        cursor: pointer;
    }

    a {
        text-decoration: none;
        color: inherit;
    }

    .container {
        width: min(1180px, 92%);
        margin: auto;
    }

    /* TOP BAR */

    .top-bar {
        background: var(--dark);
        color: white;
        text-align: center;
        padding: 9px;
        font-size: 13px;
    }

    /* HEADER */

    header {
        background: white;
        border-bottom: 1px solid var(--border);
        position: sticky;
        top: 0;
        z-index: 1000;
    }

    .header-main {
        min-height: 80px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 30px;
    }

    .logo {
        font-family: Georgia, serif;
        font-size: 27px;
        font-weight: bold;
        white-space: nowrap;
    }

    .logo span {
        color: var(--green);
    }

    .search {
        flex: 1;
        max-width: 500px;
        position: relative;
    }

    .search input {
        width: 100%;
        padding: 14px 45px 14px 18px;
        border: 1px solid var(--border);
        border-radius: 30px;
        outline: none;
        background: #fafafa;
    }

    .search-icon {
        position: absolute;
        right: 17px;
        top: 12px;
        font-size: 20px;
    }

    .header-actions {
        display: flex;
        gap: 12px;
        align-items: center;
    }

    .icon-btn {
        border: none;
        background: transparent;
        font-size: 22px;
        position: relative;
    }

    .cart-count {
        position: absolute;
        top: -7px;
        right: -8px;
        background: #c53d35;
        color: white;
        font-size: 11px;
        width: 19px;
        height: 19px;
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    /* NAV */

    .nav {
        border-top: 1px solid #f0eee9;
    }

    .nav-inner {
        min-height: 48px;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 35px;
        font-size: 14px;
    }

    .nav a:hover {
        color: var(--green);
    }

    /* HERO */

    .hero {
        background: var(--cream);
        padding: 75px 0;
    }

    .hero-grid {
        display: grid;
        grid-template-columns: 1.1fr .9fr;
        align-items: center;
        gap: 60px;
    }

    .hero-label {
        color: var(--gold);
        font-weight: bold;
        letter-spacing: 2px;
        font-size: 13px;
        margin-bottom: 18px;
    }

    .hero h1 {
        font-family: Georgia, serif;
        font-size: clamp(42px, 5vw, 68px);
        line-height: 1.05;
        margin-bottom: 22px;
    }

    .hero p {
        color: #666;
        font-size: 18px;
        max-width: 560px;
        line-height: 1.7;
        margin-bottom: 30px;
    }

    .primary-btn {
        display: inline-block;
        border: none;
        background: var(--green);
        color: white;
        padding: 15px 25px;
        border-radius: 7px;
        font-weight: bold;
        transition: .25s;
    }

    .primary-btn:hover {
        background: var(--green-dark);
        transform: translateY(-2px);
    }

    .hero-image {
        min-height: 450px;
        border-radius: 10px;
        background:
            linear-gradient(rgba(0,0,0,.05), rgba(0,0,0,.05)),
            url("https://images.unsplash.com/photo-1544947950-fa07a98d237f?auto=format&fit=crop&w=1000&q=85")
            center / cover;
    }

    /* CATEGORIES */

    section {
        padding: 80px 0;
    }

    .section-header {
        text-align: center;
        margin-bottom: 45px;
    }

    .section-header h2 {
        font-family: Georgia, serif;
        font-size: 38px;
        margin-bottom: 10px;
    }

    .section-header p {
        color: var(--gray);
    }

    .categories {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 15px;
    }

    .category {
        background: var(--cream);
        padding: 25px 15px;
        text-align: center;
        border-radius: 8px;
        border: 1px solid transparent;
        transition: .25s;
    }

    .category:hover {
        border-color: var(--green);
        transform: translateY(-3px);
    }

    .category-icon {
        font-size: 35px;
        margin-bottom: 10px;
    }

    /* PRODUCTS */

    .products-section {
        background: #fafafa;
    }

    .filter-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
        gap: 15px;
    }

    .filter-bar select {
        padding: 11px 15px;
        border: 1px solid var(--border);
        border-radius: 6px;
        background: white;
    }

    .products {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 25px;
    }

    .book-card {
        background: white;
        border: 1px solid var(--border);
        border-radius: 9px;
        overflow: hidden;
        position: relative;
        transition: .25s;
    }

    .book-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 35px rgba(0,0,0,.08);
    }

    .book-cover {
        height: 300px;
        overflow: hidden;
        background: #eee;
    }

    .book-cover img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: .4s;
    }

    .book-card:hover .book-cover img {
        transform: scale(1.04);
    }

    .favorite {
        position: absolute;
        top: 12px;
        right: 12px;
        width: 36px;
        height: 36px;
        border: none;
        background: white;
        border-radius: 50%;
        font-size: 19px;
        box-shadow: 0 3px 10px rgba(0,0,0,.12);
    }

    .favorite.active {
        color: #c53d35;
    }

    .book-info {
        padding: 20px;
    }

    .book-category {
        color: var(--green);
        font-size: 12px;
        text-transform: uppercase;
        font-weight: bold;
        margin-bottom: 8px;
    }

    .book-title {
        font-family: Georgia, serif;
        font-size: 20px;
        margin-bottom: 7px;
    }

    .book-author {
        color: var(--gray);
        font-size: 14px;
        margin-bottom: 14px;
    }

    .rating {
        font-size: 13px;
        margin-bottom: 15px;
    }

    .book-bottom {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
    }

    .price {
        font-weight: bold;
        font-size: 20px;
    }

    .add-btn {
        border: none;
        background: var(--green);
        color: white;
        padding: 10px 13px;
        border-radius: 6px;
        font-size: 13px;
    }

    .add-btn:hover {
        background: var(--green-dark);
    }

    /* ABOUT */

    .about-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 60px;
        align-items: center;
    }

    .about-image {
        min-height: 400px;
        border-radius: 10px;
        background:
            url("https://images.unsplash.com/photo-1495446815901-a7297e633e8d?auto=format&fit=crop&w=1000&q=85")
            center / cover;
    }

    .about-text h2 {
        font-family: Georgia, serif;
        font-size: 42px;
        margin-bottom: 20px;
    }

    .about-text p {
        color: #666;
        line-height: 1.8;
        margin-bottom: 20px;
    }

    .advantages {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 15px;
        list-style: none;
    }

    .advantages li {
        background: var(--cream);
        padding: 15px;
        border-radius: 6px;
    }

    /* NEWSLETTER */

    .newsletter {
        background: var(--green);
        color: white;
    }

    .newsletter-box {
        text-align: center;
        max-width: 700px;
        margin: auto;
    }

    .newsletter h2 {
        font-family: Georgia, serif;
        font-size: 40px;
        margin-bottom: 15px;
    }

    .newsletter p {
        color: #dce8df;
        margin-bottom: 25px;
    }

    .newsletter-form {
        display: flex;
        gap: 10px;
    }

    .newsletter-form input {
        flex: 1;
        padding: 15px;
        border: none;
        border-radius: 6px;
        outline: none;
    }

    .newsletter-form button {
        background: var(--gold);
        border: none;
        color: white;
        padding: 15px 22px;
        border-radius: 6px;
        font-weight: bold;
    }

    /* FOOTER */

    footer {
        background: #151515;
        color: white;
        padding: 60px 0 25px;
    }

    .footer-grid {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr 1fr;
        gap: 40px;
    }

    footer h3 {
        margin-bottom: 18px;
    }

    footer p,
    footer a {
        color: #aaa;
        font-size: 14px;
        line-height: 1.8;
    }

    .footer-links {
        display: grid;
        gap: 5px;
    }

    .copyright {
        border-top: 1px solid #333;
        margin-top: 45px;
        padding-top: 20px;
        color: #777;
        font-size: 13px;
    }

    /* CART */

    .cart-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,.45);
        z-index: 2000;
        display: none;
    }

    .cart-overlay.open {
        display: block;
    }

    .cart {
        position: absolute;
        right: 0;
        top: 0;
        height: 100%;
        width: min(430px, 100%);
        background: white;
        padding: 25px;
        display: flex;
        flex-direction: column;
    }

    .cart-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid var(--border);
        padding-bottom: 18px;
    }

    .close-cart {
        border: none;
        background: none;
        font-size: 25px;
    }

    .cart-items {
        flex: 1;
        overflow-y: auto;
        padding: 20px 0;
    }

    .cart-item {
        display: flex;
        gap: 12px;
        margin-bottom: 18px;
        padding-bottom: 18px;
        border-bottom: 1px solid #eee;
    }

    .cart-item img {
        width: 65px;
        height: 85px;
        object-fit: cover;
        border-radius: 4px;
    }

    .cart-item-info {
        flex: 1;
    }

    .cart-item-info h4 {
        font-family: Georgia, serif;
        margin-bottom: 7px;
    }

    .cart-item-info p {
        color: var(--gray);
        font-size: 13px;
    }

    .remove-item {
        border: none;
        background: none;
        color: #c53d35;
        font-size: 13px;
    }

    .cart-footer {
        border-top: 1px solid var(--border);
        padding-top: 20px;
    }

    .total {
        display: flex;
        justify-content: space-between;
        font-size: 21px;
        font-weight: bold;
        margin-bottom: 18px;
    }

    .checkout {
        width: 100%;
    }

    .empty-cart {
        text-align: center;
        color: #888;
        padding: 50px 10px;
    }

    /* TOAST */

    .toast {
        position: fixed;
        bottom: 25px;
        left: 50%;
        transform: translate(-50%, 100px);
        background: #222;
        color: white;
        padding: 14px 22px;
        border-radius: 7px;
        z-index: 3000;
        opacity: 0;
        transition: .3s;
    }

    .toast.show {
        transform: translate(-50%, 0);
        opacity: 1;
    }

    /* MOBILE */

    @media (max-width: 950px) {

        .products {
            grid-template-columns: repeat(2, 1fr);
        }

        .categories {
            grid-template-columns: repeat(3, 1fr);
        }

        .footer-grid {
            grid-template-columns: 1fr 1fr;
        }

        .hero-grid,
        .about-grid {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 650px) {

        .header-main {
            flex-wrap: wrap;
            padding: 15px 0;
        }

        .search {
            order: 3;
            max-width: none;
            flex-basis: 100%;
        }

        .nav-inner {
            overflow-x: auto;
            justify-content: flex-start;
            padding: 10px 0;
        }

        .hero {
            padding: 50px 0;
        }

        .hero h1 {
            font-size: 42px;
        }

        .hero-image {
            min-height: 330px;
        }

        section {
            padding: 55px 0;
        }

        .categories {
            grid-template-columns: 1fr 1fr;
        }

        .products {
            grid-template-columns: 1fr;
        }

        .book-cover {
            height: 370px;
        }

        .advantages {
            grid-template-columns: 1fr;
        }

        .newsletter-form {
            flex-direction: column;
        }

        .footer-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
</head>

